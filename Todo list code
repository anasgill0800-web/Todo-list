import 'package:flutter/material.dart';

void main() {
  runApp(const DailyRoutineApp());
}

class DailyRoutineApp extends StatelessWidget {
  const DailyRoutineApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'Daily Routine',
      theme: ThemeData(
        useMaterial3: true,
        colorSchemeSeed: const Color(0xFF635BEE),
        scaffoldBackgroundColor: const Color(0xFFF4F5FB),
      ),
      home: const HomeScreen(),
    );
  }
}

class HomeScreen extends StatelessWidget {
  const HomeScreen({super.key});

  @override
  Widget build(BuildContext context) {
    final tasks = [
      ['Fajr Namaz', '5:15 AM', Icons.mosque, true],
      ['Morning Gym', '6:30 AM', Icons.fitness_center, true],
      ['Flutter Study', '9:00 AM', Icons.menu_book, false],
      ['Office Work', '2:00 PM', Icons.work, false],
    ];

    return Scaffold(
      appBar: AppBar(
        title: const Text('Daily Routine'),
        backgroundColor: Colors.white,
      ),
      body: ListView(
        padding: const EdgeInsets.all(16),
        children: [
          Container(
            padding: const EdgeInsets.all(22),
            decoration: BoxDecoration(
              gradient: const LinearGradient(
                colors: [Color(0xFF635BEE), Color(0xFF9285FA)],
              ),
              borderRadius: BorderRadius.circular(22),
            ),
            child: const Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(
                  'Good Morning 👋',
                  style: TextStyle(color: Colors.white70),
                ),
                SizedBox(height: 8),
                Text(
                  'Your Daily Goals',
                  style: TextStyle(
                    color: Colors.white,
                    fontSize: 24,
                    fontWeight: FontWeight.bold,
                  ),
                ),
                SizedBox(height: 12),
                Text(
                  '2 of 4 tasks completed',
                  style: TextStyle(color: Colors.white),
                ),
                SizedBox(height: 10),
                LinearProgressIndicator(
                  value: 0.5,
                  backgroundColor: Colors.white30,
                  color: Colors.white,
                ),
              ],
            ),
          ),
          const SizedBox(height: 24),
          const Text(
            'Categories',
            style: TextStyle(fontSize: 20, fontWeight: FontWeight.bold),
          ),
          const SizedBox(height: 12),
          Wrap(
            spacing: 8,
            children: [
              'All',
              'Study',
              'Namaz',
              'Gym',
              'Work',
            ].map((name) {
              return Chip(label: Text(name));
            }).toList(),
          ),
          const SizedBox(height: 16),
          const Text(
            "Today's Tasks",
            style: TextStyle(fontSize: 20, fontWeight: FontWeight.bold),
          ),
          const SizedBox(height: 8),
          ...tasks.map((task) {
            final done = task[3] as bool;

            return Card(
              color: Colors.white,
              margin: const EdgeInsets.symmetric(vertical: 6),
              child: ListTile(
                leading: CircleAvatar(
                  backgroundColor: const Color(0xFFEAE8FF),
                  child: Icon(
                    task[2] as IconData,
                    color: const Color(0xFF635BEE),
                  ),
                ),
                title: Text(task[0] as String),
                subtitle: Text(task[1] as String),
                trailing: Icon(
                  done ? Icons.check_circle : Icons.circle_outlined,
                  color: done ? Colors.green : Colors.grey,
                ),
              ),
            );
          }),
        ],
      ),
      floatingActionButton: FloatingActionButton.extended(
        onPressed: () {},
        icon: const Icon(Icons.add),
        label: const Text('Add Task'),
      ),
    );
  }
}